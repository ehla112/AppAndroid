<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".ActivityVacunas">

    <!-- Título -->

    <!-- EditTexts -->
    <TextView
        android:id="@+id/tvTituloVacunas"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/tvTituloVacunas"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/etNombreVacuna"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:hint="@string/hint_nombre_vacuna"
        app:layout_constraintTop_toBottomOf="@id/tvTituloVacunas"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp" />

    <EditText
        android:id="@+id/etFechaVacuna"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:hint="@string/hint_fecha_vacuna"
        android:focusable="false"
        android:clickable="true"
        android:inputType="none"
        app:layout_constraintTop_toBottomOf="@id/etNombreVacuna"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="10dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp" />

    <EditText
        android:id="@+id/etTipoVacuna"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:hint="@string/hint_tipo_vacuna"
        app:layout_constraintTop_toBottomOf="@id/etFechaVacuna"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="10dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp" />

    <EditText
        android:id="@+id/etDiasRecientes"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:hint="@string/etDiasRecientes"
        android:inputType="number"
        app:layout_constraintTop_toBottomOf="@id/etTipoVacuna"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="10dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp" />

    <!-- TableLayout con los botones -->
    <TableLayout
        android:id="@+id/tableButtons"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:stretchColumns="0,1"
        app:layout_constraintTop_toBottomOf="@id/etDiasRecientes"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp">

        <TableRow>
            <Button
                android:id="@+id/btnBuscarRecientes"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/btnBuscarRecientes"
                android:backgroundTint="@color/bottoncolor"
                android:layout_weight="1"/>
            <Button
                android:id="@+id/btnAddvacuna"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/btnAddvacuna"
                android:backgroundTint="@color/bottoncolor"
                android:layout_weight="1"/>
        </TableRow>

        <TableRow>
            <Button
                android:id="@+id/btnActualizarVacuna"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/btnActvacuna"
                android:backgroundTint="@color/bottoncolor"
                android:layout_weight="1"/>
            <Button
                android:id="@+id/btnBuscarVacuna"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/btnBuscarVacuna"
                android:backgroundTint="@color/bottoncolor"
                android:layout_weight="1"/>
        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <Button
                android:id="@+id/btnEliminarVacuna"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="@color/bottoncolor2"
                android:text="@string/btnDeletevacuna" />

            <Space
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
        </TableRow>

    </TableLayout>

    <!-- Lista -->
    <ListView
        android:id="@+id/lvVacunas"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tableButtons"
        app:layout_constraintVertical_bias="1.0" />
</androidx.constraintlayout.widget.ConstraintLayout>
